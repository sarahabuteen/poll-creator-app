# Copy to .env.local and fill in. Never commit real values.

# Hosted Postgres (Neon). Use the *pooled* connection string.
# Leave unset locally to use the embedded PGlite database in ./.pglite instead.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/tiebreak?sslmode=require

# Where local PGlite keeps its data (ignored when DATABASE_URL is set).
# PGLITE_DATA_DIR=.pglite

# Base URL used to build share links. Set to the production URL on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs session cookies. Required in production (set it in Vercel for all environments).
# Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Local testing only. When set, `npm run db:seed` gives the sample creator
# (morgan@tiebreak.test) this password so you can log in and manage the sample polls.
# Don't set it for a database the public can reach.
# SAMPLE_CREATOR_PASSWORD=
