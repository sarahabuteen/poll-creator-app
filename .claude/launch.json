{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "next-dev-local",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "DATABASE_URL=",
        "PGLITE_DATA_DIR=.pglite-e2e",
        "NEXT_PUBLIC_APP_URL=http://localhost:3001",
        "npx",
        "next",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    }
  ]
}
